{
  "name": "fedoraicons.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Fedora Icons website: search, customize, and export icons.",
  "scripts": {
    "sync": "node scripts/sync-icons.mjs",
    "sync:check": "node scripts/sync-icons.mjs --check",
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run sync:check && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.28.9",
  "dependencies": {
    "@fontsource-variable/asta-sans": "^5.3.0",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "fflate": "0.8.2",
    "highlight.js": "11.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
